# Google Places API (New) key for the organization finder. Copy to .env and fill in. Required: there is no mock fallback.
# On Vercel, set it before the build (Vite bakes it into the bundle) and redeploy after changing it.
VITE_GOOGLE_PLACES_API_KEY=

# Server-only key for the business-profile pre-fill (Place Details). Never prefix with VITE_. Falls back to the key above when empty.
GOOGLE_PLACES_API_KEY=
